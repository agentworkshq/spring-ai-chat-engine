# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DB_NAME=chatengine
DB_USER=chat
DB_PASSWORD=chat

# Optional protection. When API_KEY_ENABLED=true, clients must send X-API-Key: <API_KEY>
# (health checks and OpenAPI docs stay open). Use a long random value, e.g. `openssl rand -hex 32`.
API_KEY_ENABLED=false
API_KEY=
# Per-client-IP limit on the two message endpoints.
RATE_LIMIT_RPM=20
